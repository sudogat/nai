# Directivas seguras para data/. Todo va envuelto en <IfModule> para que
# Apache no devuelva 500/403 si el módulo no está cargado en WebEmpresa.

Options -Indexes

<IfModule mod_headers.c>
    <FilesMatch "\.json$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

# Nginx front en WebEmpresa aplica max-age agresivo. mod_expires no siempre
# vence al microcache, pero al menos deja instrucción clara a los caches
# intermedios.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 60 seconds"
</IfModule>

<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/plain text/html text/xml text/javascript application/javascript
</IfModule>
